 export type SortFunc<T> = (a: T, b: T) => number;
 
+// getLastActiveTimestamp only looks at the live timeline. With threadSupport,
+// thread replies go to their thread instead, so a room whose recent events are
+// all thread replies has an empty live timeline after a reload and would sort
+// last. Count the latest thread reply as activity too.
+const getLastActivity = (room: Room | null): number => {
+  if (!room) return Number.MIN_SAFE_INTEGER;
+  return room
+    .getThreads()
+    .reduce(
+      (ts, thread) => Math.max(ts, thread.replyToEvent?.getTs() ?? Number.MIN_SAFE_INTEGER),
+      room.getLastActiveTimestamp()
+    );
+};
