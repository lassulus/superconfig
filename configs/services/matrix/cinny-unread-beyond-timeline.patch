+/**
+ * roomHaveUnread only sees the events the sync loaded (initialSyncLimit). If
+ * our read receipt points at an older event, it can't tell whether anything
+ * worth reading came in between, e.g. when only membership/ACL changes
+ * followed the receipt. Ask the server for notification events after our
+ * public and private receipt; if none follows one of them, remember the latest
+ * live event as read, so roomHaveUnread returns false until a new
+ * notification event arrives.
+ * Resolves to true if the room was confirmed read.
+ */
+export const confirmReadBeyondTimeline = async (mx: MatrixClient, room: Room) => {
+  const userId = mx.getUserId();
+  if (!userId || room.getEventReadUpTo(userId)) return false;
+  const liveEvents = room.getLiveTimeline().getEvents();
+  // The receipt is older than every loaded event, so a loaded notification
+  // event is unread for sure.
+  if (liveEvents.some(isNotificationEvent)) return false;
+  const latestId = liveEvents.at(-1)?.getId();
+  if (!latestId) return false;
+
+  const receiptEventIds = [ReceiptType.ReadPrivate, ReceiptType.Read]
+    .map((type) => room.getReadReceiptForUserId(userId, false, type)?.eventId)
+    .filter((eventId): eventId is string => !!eventId);
+  const unreadAfter = await Promise.all(
+    receiptEventIds.map((eventId) => hasNotificationEventAfter(mx, room.roomId, eventId))
+  );
+  if (!unreadAfter.includes(false)) return false;
+  confirmedReadUpTo.set(room, latestId);
+  return true;
+};
