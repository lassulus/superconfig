+const hasNotificationEventAfter = async (
+  mx: MatrixClient,
+  roomId: string,
+  eventId: string
+): Promise<boolean> => {
+  const roomPath = `/rooms/${encodeURIComponent(roomId)}`;
+  const filter = JSON.stringify({
+    types: NOTIFICATION_EVENT_TYPES.filter((type) => type !== 'm.room.member'),
+  });
+  const context = await mx.http.authedRequest<{ events_after: IEvent[]; end?: string }>(
+    Method.Get,
+    `${roomPath}/context/${encodeURIComponent(eventId)}`,
+    { limit: '20', filter }
+  );
+  let events = context.events_after;
+  let from = context.end;
