+    if (events.some((event) => isNotificationEvent(new MatrixEvent(event)))) return true;
+    if (!from) return false;
+    // eslint-disable-next-line no-await-in-loop
+    const page = await mx.http.authedRequest<{ chunk: IEvent[]; end?: string }>(
+      Method.Get,
+      `${roomPath}/messages`,
+      { from, dir: Direction.Forward, limit: '50', filter }
+    );
+    if (page.chunk.length === 0) return false;
+    events = page.chunk;
+    from = page.end;
+  }
+};
