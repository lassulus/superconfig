diff -r a/lib/web/imageRouter/krebspaste.js b/lib/web/imageRouter/krebspaste.js
--- a/lib/web/imageRouter/krebspaste.js	1970-01-01 01:00:00.000000000 +0100
+++ b/lib/web/imageRouter/krebspaste.js	2026-10-11 08:22:41.108085483 +0200
@@ -0,0 +1,62 @@
+'use strict'
+// Uploads to a krebs paste service (https://p.krebsco.de): images to its
+// imgur-compatible /image endpoint, everything else (and images /image
+// rejects) as a plain paste to /.
+const fs = require('fs')
+
+const config = require('../../config')
+const logger = require('../../logger')
+
+async function post (url, body) {
+  const res = await fetch(url, { method: 'POST', body })
+  const text = await res.text()
+  return { status: res.status, ok: res.ok, text }
+}
+
+// The service reports links with the scheme/host it saw; keep only the path.
+function rebase (link, base) {
+  return new URL(new URL(link).pathname, base).href
+}
+
+async function upload (filePath) {
+  const base = config.krebspaste.url
+  const body = fs.readFileSync(filePath)
+  const FileType = await import('file-type')
+  const type = await FileType.fileTypeFromBuffer(body)
+
+  if (type && type.mime.startsWith('image/')) {
+    const res = await post(new URL('/image', base), body)
+    if (res.ok) {
+      return rebase(JSON.parse(res.text).data.link, base)
+    }
+    if (res.status !== 400) {
+      throw new Error(`krebspaste /image: ${res.status} ${res.text}`)
+    }
+    logger.debug(`krebspaste: /image rejected ${type.mime}, pasting instead`)
+  }
+
+  const res = await post(new URL('/', base), body)
+  if (!res.ok) {
+    throw new Error(`krebspaste /: ${res.status} ${res.text}`)
+  }
+  // one link per line: full hash, then the short one if unambiguous
+  const links = res.text.trim().split('\n')
+  return rebase(links[links.length - 1], base)
+}
+
+exports.uploadImage = function (imagePath, callback) {
+  if (!callback || typeof callback !== 'function') {
+    logger.error('Callback has to be a function')
+    return
+  }
+
+  if (!imagePath || typeof imagePath !== 'string') {
+    callback(new Error('Image path is missing or wrong'), null)
+    return
+  }
+
+  upload(imagePath).then(
+    (url) => callback(null, url),
+    (err) => callback(err, null)
+  )
+}
