{
  "uid": "logs",
  "title": "Logs explorer",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "host",
          "query": "*",
          "limit": 1000
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "unit",
        "type": "query",
        "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "unit",
          "query": "host:in($host)",
          "limit": 1000
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "type": "textbox",
        "query": "*",
        "current": { "text": "*", "value": "*" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Journal",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 24 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "host:in($host) unit:in($unit) $search",
          "maxLines": 1000
        }
      ]
    }
  ]
}
