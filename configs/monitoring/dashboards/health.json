      "gridPos": { "x": 8, "y": 46, "w": 8, "h": 8 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "timeFrom": "28d",
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "unit": "m",
