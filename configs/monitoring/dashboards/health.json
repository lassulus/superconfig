              { "color": "red", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "green", "value": 80 },
              { "color": "blue", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(gadgetbridge_sleep_score[1d])",
          "legendFormat": "Sleep score"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "HRV per night",
      "description": "Last-night average HRV with Garmin's balanced baseline band; below \"low\" is the unbalanced/low range.",
      "gridPos": { "x": 4, "y": 29, "w": 10, "h": 8 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "timeFrom": "14d",
      "interval": "1d",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "always", "pointSize": 6, "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF6940" } },
              { "id": "custom.lineWidth", "value": 0 },
              { "id": "custom.showPoints", "value": "never" },
              { "id": "custom.hideFrom", "value": { "legend": true, "tooltip": false, "viz": false } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "C" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF6940" } },
              { "id": "custom.lineWidth", "value": 0 },
              { "id": "custom.showPoints", "value": "never" },
              { "id": "custom.fillBelowTo", "value": "Balanced lower" },
              { "id": "custom.fillOpacity", "value": 25 }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "D" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.showPoints", "value": "never" },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time(gadgetbridge_hrv_last_night_average[1d] offset -25h)",
          "legendFormat": "Last night average"
        },
        {
          "refId": "B",
          "expr": "max_over_time(gadgetbridge_hrv_baseline_balanced_lower[1d] offset -25h)",
          "legendFormat": "Balanced lower"
        },
        {
          "refId": "C",
          "expr": "max_over_time(gadgetbridge_hrv_baseline_balanced_upper[1d] offset -25h)",
          "legendFormat": "Balanced range"
        },
        {
          "refId": "D",
          "expr": "max_over_time(gadgetbridge_hrv_baseline_low_upper[1d] offset -25h)",
          "legendFormat": "Low"
        }
      ]
    },
