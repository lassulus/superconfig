      "id": 30,
      "type": "timeseries",
      "title": "Steps per hour",
      "description": "Steps, active calories and distance are daily counters on the watch (reset at local midnight); per-hour values are their increase.",
      "gridPos": { "x": 0, "y": 38, "w": 12, "h": 8 },
