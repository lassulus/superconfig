{
  "uid": "gatus",
  "title": "Gatus",
  "schemaVersion": 39,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Endpoint success",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 16 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "down", "color": "red" },
                "1": { "text": "up", "color": "green" }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gatus_results_endpoint_success",
          "legendFormat": "{{vantage}} {{group}}/{{name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Response time",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "gatus_results_duration_seconds",
          "legendFormat": "{{vantage}} {{group}}/{{name}}"
        }
      ]
    }
  ]
}
