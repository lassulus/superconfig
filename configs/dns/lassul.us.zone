_dmarc IN TXT "v=DMARC1; p=reject; adkim=r; aspf=r; rua=mailto:postmaster@lassul.us; ruf=mailto:postmaster@lassul.us; pct=100"
@ IN TXT "v=spf1 mx -all"

;; Autodiscovery (RFC 6186)
_imaps._tcp IN SRV 5 0 993 mail.lassul.us.
_submissions._tcp IN SRV 5 0 465 mail.lassul.us.

;; parley instance discovery for nick@lassul.us
_parley._tcp IN SRV 0 0 443 parley.lassul.us.

@ IN CAA 0 issue "letsencrypt.org"
@ IN CAA 0 iodef "mailto:caa@lassul.us"
