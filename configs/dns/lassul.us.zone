; serial is ignored: knot loads this file with zonefile-load = difference-no-serial and serial-policy = dateserial (configs/dns/knot.nix) and bumps the served serial itself, so never edit it
@ 3600 IN SOA lassul.us. ns1.lassul.us. 1 7200 3600 86400 3600

;;@ 3600 IN NS ns1
@ 3600 IN NS ns1
@ 3600 IN NS ns1.first-ns.de.
@ 3600 IN NS robotns2.second-ns.de.
@ 3600 IN NS robotns3.second-ns.com.


$TTL 600

;; NS Records
he IN NS ns1.first-ns.de.
he IN NS robotns2.second-ns.de.
he IN NS robotns3.second-ns.com.

@ IN A 95.217.192.59
@ IN AAAA 2a01:4f9:4a:4f1a::2
neoprism IN A 95.217.192.59
4.neoprism IN A 95.217.192.59
neoprism IN AAAA 2a01:4f9:4a:4f1a::2
6.neoprism IN AAAA 2a01:4f9:4a:4f1a::2
prism IN CNAME neoprism
ipfs IN CNAME neoprism
starkstrom IN A 194.110.87.67

;; GLUE
ns1 IN A 95.217.192.59
ns1 IN AAAA 2a01:4f9:4a:4f1a::2

* IN CNAME www

www IN CNAME neoprism
cgit IN CNAME neoprism
pad IN CNAME neoprism
paint IN CNAME neoprism
ntfy IN CNAME neoprism
go IN CNAME neoprism
