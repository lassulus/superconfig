bin "book"
about "Serve a request-and-approve booking page whose free/busy and bookings live in a CalDAV calendar"

flag "--config" help="JSON configuration file (see configs/book.nix)" required=#true {
  arg "<file>"
}
flag "--caldav-password-file" help="File holding the CalDAV user's password" required=#true {
  arg "<file>"
}
flag "--busy-token-file" help="File holding the secret token of the busy-only iCalendar feed /busy/<token>.ics (no feed without it)" {
  arg "<file>"
}
flag "--templates" help="Template directory (default: $BOOK_TEMPLATES, set by the package)" {
  arg "<dir>"
}
flag "--static" help="Static file directory (default: $BOOK_STATIC, set by the package)" {
  arg "<dir>"
}
