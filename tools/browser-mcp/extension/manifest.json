{
  "manifest_version": 2,
  "name": "Browser MCP",
  "version": "1.0.0",
  "description": "Lets local AI agents control browser tabs through the browser-mcp native messaging host, without WebDriver/Marionette.",
  "permissions": ["tabs", "nativeMessaging", "<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-mcp@lassul.us",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
