bin "sunray"
about "Stream a host's desktop to Moonlight; ssh does the auth and carries the stream"

flag "-o <key=value>" help="Sunshine config override on the host (repeatable)" var=#true
flag "-h --help" help="Show help message"

arg "<host>" help="Host to stream from, anything ssh accepts"
arg "[app]" help="Sunshine app to start (default: Desktop)"
