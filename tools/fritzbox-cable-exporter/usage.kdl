bin "fritzbox-cable-exporter"
about "Prometheus exporter for a FRITZ!Box Cable: DOCSIS channels from the web UI, router and connection status via TR-064"

flag "--host" help="FRITZ!Box address (default: 192.168.178.1)" {
  arg "<host>"
}
flag "--password-file" help="File holding the FRITZ!Box password" required=#true {
  arg "<file>"
}
flag "--listen" help="host:port serving /metrics (default: 127.0.0.1:9764)" {
  arg "<host:port>"
}
flag "--once" help="Print the metrics once and exit"
