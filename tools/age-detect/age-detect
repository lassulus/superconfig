#!/usr/bin/env bash
set -euo pipefail

# age-detect: Detects connected age-compatible security keys
# Returns identity file path and detected key information

# Function to detect connected security keys and their age identities
detect_age_keys() {
    local temp_identities
    temp_identities=$(mktemp)

    # Check for Secure Enclave on macOS (highest priority)
    if [[ "$(uname)" == "Darwin" ]] && command -v age-plugin-se >/dev/null 2>&1; then
        rm -f "$temp_identities"
        echo "DETECTED_KEY=se"
        echo "KEY_TYPE=se"
        return
    fi

    # Check for TPM on Linux (second priority - built-in, no USB needed)
    # Requires: TPM device, hostname.age with age1tpm1/age1tag1 recipient, and identity in ~/.config/age/
    # Newer age-plugin-tpm emits native p256tag (age1tag1) recipients by default.
    if [[ -c /dev/tpmrm0 ]] && [[ -f ~/.config/age/tpm-identity.txt ]]; then
        local hostname_key
        hostname_key="${AGE_DETECT_KEYS_DIR:-}/age/$(hostname).age"
        if [[ -f "$hostname_key" ]] && grep -qE "^age1(tpm|tag)1" "$hostname_key" 2>/dev/null; then
            rm -f "$temp_identities"
            echo "DETECTED_KEY=tpm"
            echo "KEY_TYPE=tpm"
            return
        fi
    fi

    # Check for a running phonetpm daemon (third priority - phone over iroh,
    # every decryption asks for a fingerprint on the phone).
    # Requires: control socket of configs/phonetpm.nix and phonetpm.identity.
    local phone_identity="${AGE_DETECT_KEYS_DIR:-}/age/phonetpm.identity"
    if [[ -S "${XDG_RUNTIME_DIR:-}/phonetpm/control.sock" ]] && [[ -f "$phone_identity" ]]; then
        cp "$phone_identity" "$temp_identities"
        echo "IDENTITY_FILE=$temp_identities"
        echo "DETECTED_KEY=phonetpm"
        echo "KEY_TYPE=phone"
        return
    fi

    # Check for gpg-agent with an encryption subkey (fourth priority).
    # Frictionless after the first decrypt because gpg-agent caches the
    # passphrase / smartcard PIN, so we prefer it over yubikey/solo2.
    if command -v gpg-connect-agent >/dev/null 2>&1 \
        && gpg-connect-agent /bye >/dev/null 2>&1 \
        && gpg --list-secret-keys --with-colons 2>/dev/null \
             | awk -F: '$1 == "ssb" && $12 ~ /e/ { found=1 } END { exit !found }'; then
        echo "AGE-PLUGIN-GPG-1H40XPM" > "$temp_identities"
        echo "IDENTITY_FILE=$temp_identities"
        echo "DETECTED_KEY=gpg"
        echo "KEY_TYPE=gpg"
        return
    fi

    # Check for YubiKeys (fifth priority)
    if command -v ykman >/dev/null 2>&1; then
        local yubikey_serial
        yubikey_serial=$(ykman info 2>/dev/null | grep "Serial number:" | cut -d: -f2 | tr -d ' ' || true)
        if [[ -n "$yubikey_serial" ]]; then
            echo "AGE-PLUGIN-YUBIKEY-1M2PLUQYZ242EPUSSHDFWJ" > "$temp_identities"
            echo "IDENTITY_FILE=$temp_identities"
            case "$yubikey_serial" in
                "16679898")
                    echo "DETECTED_KEY=yubi1"
                    ;;
                "11342136")
                    echo "DETECTED_KEY=yubi2"
                    ;;
                *)
                    echo "DETECTED_KEY=yubikey-${yubikey_serial}"
                    ;;
            esac
            echo "KEY_TYPE=yubikey"
            return
        fi
    fi

    # Check for Solo2 (lowest priority)
    if command -v fido2-token >/dev/null 2>&1; then
        if fido2-token -L 2>/dev/null | grep -q "Solo 2"; then
            # FIDO2-HMAC doesn't use identity file
            rm -f "$temp_identities"
            echo "IDENTITY_FILE="
            echo "DETECTED_KEY=solo2"
            echo "KEY_TYPE=solo2"
            return
        fi
    fi

    # No keys detected
    rm -f "$temp_identities"
    echo "IDENTITY_FILE="
    echo "DETECTED_KEY="
    echo "KEY_TYPE="
}

# Parse command line arguments
case "${1:-detect}" in
    detect)
        detect_age_keys
        ;;
    --help|-h)
        echo "Usage: age-detect [detect]"
        echo ""
        echo "Detects the first available age-compatible security key and outputs:"
        echo "  IDENTITY_FILE=<path>  - Path to temporary identity file for age (empty for Solo2)"
        echo "  DETECTED_KEY=<name>   - Name of the detected key (e.g., yubi1, solo2, se)"
        echo "  KEY_TYPE=<type>       - Type of key (yubikey, solo2, se, tpm, phone, gpg)"
        echo ""
        echo "Priority order: se > tpm > phone > gpg > yubikey > solo2"
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Use --help for usage information" >&2
        exit 1
        ;;
esac
