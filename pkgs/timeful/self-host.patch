@@ -0,0 +1,241 @@
+/* GitHub OAuth sign-in (self-host patch). Accounts are keyed by the GitHub
+ * account's primary verified email, like the email OTP flow, and carry no
+ * calendar access. */
+package routes
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/gin-contrib/sessions"
+	"github.com/gin-gonic/gin"
+	"go.mongodb.org/mongo-driver/bson"
+	"go.mongodb.org/mongo-driver/bson/primitive"
+	"schej.it/server/db"
+	"schej.it/server/logger"
+	"schej.it/server/models"
+	"schej.it/server/utils"
+)
+
+var githubHttpClient = &http.Client{Timeout: 10 * time.Second}
+
+// Session keys holding the in-flight sign-in between the redirect to GitHub
+// and the callback.
+const (
+	githubStateKey    = "githubState"
+	githubRedirectKey = "githubRedirect"
+	githubTzKey       = "githubTimezoneOffset"
+	githubLinkKey     = "githubEventsToLink"
+)
+
+func initGithubAuth(authRouter *gin.RouterGroup) {
+	authRouter.GET("/github", githubSignIn)
+	authRouter.GET("/github/callback", githubCallback)
+}
+
+// @Summary Starts GitHub sign-in
+// @Description Redirects to GitHub's OAuth consent page. Query: redirect (relative path to return to), timezoneOffset, eventsToLink (comma-separated event ids created while signed out)
+// @Tags auth
+// @Router /auth/github [get]
+func githubSignIn(c *gin.Context) {
+	clientId := os.Getenv("GITHUB_CLIENT_ID")
+	if clientId == "" {
+		c.String(http.StatusNotFound, "GitHub sign-in is not configured")
+		return
+	}
+
+	stateBytes := make([]byte, 32)
+	if _, err := rand.Read(stateBytes); err != nil {
+		logger.StdErr.Panicln(err)
+	}
+	state := hex.EncodeToString(stateBytes)
+
+	session := sessions.Default(c)
+	session.Set(githubStateKey, state)
+	session.Set(githubRedirectKey, safeRedirectPath(c.Query("redirect")))
+	session.Set(githubTzKey, c.Query("timezoneOffset"))
+	session.Set(githubLinkKey, c.Query("eventsToLink"))
+	session.Save()
+
+	params := url.Values{}
+	params.Set("client_id", clientId)
+	params.Set("scope", "read:user user:email")
+	params.Set("state", state)
+	c.Redirect(http.StatusFound, "https://github.com/login/oauth/authorize?"+params.Encode())
+}
+
+// @Summary GitHub OAuth callback
+// @Description Exchanges the code, finds or creates the user by primary verified email, sets the session and redirects back into the app
+// @Tags auth
+// @Router /auth/github/callback [get]
+func githubCallback(c *gin.Context) {
+	session := sessions.Default(c)
+	expectedState, _ := session.Get(githubStateKey).(string)
+	redirect, _ := session.Get(githubRedirectKey).(string)
+	tzString, _ := session.Get(githubTzKey).(string)
+	eventsToLink, _ := session.Get(githubLinkKey).(string)
+	// The state is single-use: every exit path below saves the session with
+	// these keys removed. Each Save emits a Set-Cookie, so save exactly once.
+	session.Delete(githubStateKey)
+	session.Delete(githubRedirectKey)
+	session.Delete(githubTzKey)
+	session.Delete(githubLinkKey)
+
+	fail := func(reason string, err error) {
+		logger.StdErr.Printf("GitHub sign-in failed: %s: %v", reason, err)
+		session.Save()
+		c.Redirect(http.StatusFound, "/sign-in?error=github")
+	}
+
+	if expectedState == "" || c.Query("state") != expectedState {
+		fail("state mismatch", nil)
+		return
+	}
+	if c.Query("error") != "" {
+		fail("denied", fmt.Errorf("%s", c.Query("error")))
+		return
+	}
+
+	accessToken, err := githubExchangeCode(c.Query("code"))
+	if err != nil {
+		fail("code exchange", err)
+		return
+	}
+
+	var ghUser struct {
+		Login     string `json:"login"`
+		Name      string `json:"name"`
+		AvatarUrl string `json:"avatar_url"`
+	}
+	if err := githubGet(accessToken, "/user", &ghUser); err != nil {
+		fail("fetch user", err)
+		return
+	}
+
+	var ghEmails []struct {
+		Email    string `json:"email"`
+		Primary  bool   `json:"primary"`
+		Verified bool   `json:"verified"`
+	}
+	if err := githubGet(accessToken, "/user/emails", &ghEmails); err != nil {
+		fail("fetch emails", err)
+		return
+	}
+	email := ""
+	for _, e := range ghEmails {
+		if e.Verified && (e.Primary || email == "") {
+			email = e.Email
+		}
+	}
+	if email == "" {
+		fail("no verified email", nil)
+		return
+	}
+	email = utils.NormalizeEmail(email)
+
+	var userId primitive.ObjectID
+	if existing := db.GetUserByEmail(email); existing != nil {
+		userId = existing.Id
+	} else {
+		firstName, lastName := ghUser.Login, ""
+		if name := strings.TrimSpace(ghUser.Name); name != "" {
+			firstName, lastName, _ = strings.Cut(name, " ")
+		}
+		timezoneOffset, _ := strconv.Atoi(tzString)
+
+		res, err := db.UsersCollection.InsertOne(context.Background(), models.User{
+			Email:          email,
+			FirstName:      firstName,
+			LastName:       strings.TrimSpace(lastName),
+			Picture:        ghUser.AvatarUrl,
+			TimezoneOffset: timezoneOffset,
+			TokenOrigin:    models.WEB,
+		})
+		if err != nil {
+			logger.StdErr.Panicln(err)
+		}
+		userId = res.InsertedID.(primitive.ObjectID)
+	}
+
+	// Claim events this browser created while signed out (same as /auth/sign-in)
+	for _, eventIdString := range strings.Split(eventsToLink, ",") {
+		eventId, err := primitive.ObjectIDFromHex(eventIdString)
+		if err == nil {
+			db.EventsCollection.UpdateOne(context.Background(), bson.M{"_id": eventId, "ownerId": nil}, bson.M{"$set": bson.M{"ownerId": userId}})
+		}
+	}
+
+	session.Set("userId", userId.Hex())
+	session.Save()
+
+	c.Redirect(http.StatusFound, redirect)
+}
+
+// safeRedirectPath only allows same-origin absolute paths, so the callback
+// cannot be turned into an open redirect.
+func safeRedirectPath(path string) string {
+	if !strings.HasPrefix(path, "/") || strings.HasPrefix(path, "//") || strings.HasPrefix(path, "/\\") {
+		return "/home"
+	}
+	return path
+}
+
+func githubExchangeCode(code string) (string, error) {
+	form := url.Values{}
+	form.Set("client_id", os.Getenv("GITHUB_CLIENT_ID"))
+	form.Set("client_secret", os.Getenv("GITHUB_CLIENT_SECRET"))
+	form.Set("code", code)
+
+	req, err := http.NewRequest(http.MethodPost, "https://github.com/login/oauth/access_token", strings.NewReader(form.Encode()))
+	if err != nil {
+		return "", err
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := githubHttpClient.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+
+	var body struct {
+		AccessToken string `json:"access_token"`
+		Error       string `json:"error"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&body); err != nil {
+		return "", err
+	}
+	if body.AccessToken == "" {
+		return "", fmt.Errorf("no access token (status %d, error %q)", resp.StatusCode, body.Error)
+	}
+	return body.AccessToken, nil
+}
+
+func githubGet(accessToken string, path string, out interface{}) error {
+	req, err := http.NewRequest(http.MethodGet, "https://api.github.com"+path, nil)
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Authorization", "Bearer "+accessToken)
+	req.Header.Set("Accept", "application/vnd.github+json")
+
+	resp, err := githubHttpClient.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("GET %s: status %d", path, resp.StatusCode)
+	}
+	return json.NewDecoder(resp.Body).Decode(out)
+}
