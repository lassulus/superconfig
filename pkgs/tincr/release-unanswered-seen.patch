From 1b647f2953c6b9973d9cdb336c77371a5950edc9 Mon Sep 17 00:00:00 2001
From: Hermes <hermes@lassul.us>
Date: Wed, 11 Nov 2026 11:09:37 +0100
Subject: [PATCH] tincd: stop pinning a seen UDP address whose probes go
 unanswered

An authenticated datagram's source address became the only UDP
address a node probed, and gossip or relay hints could not replace it,
until the peer became unreachable. A seen address proves only the
peer->us leg. When it dies silently (NAT mapping flushed, source
rewritten on the way), both ends kept probing the dead addresses,
UDP timed out but was never re-established, and all traffic stayed on
the relayed TCP path for good.

try_udp now releases a seen address once probes to it went unanswered
for UDPDiscoveryTimeout. It stays as a hint: choose_udp_address
explores edge addresses again and new hints may replace it. A new
authenticated datagram pins it again.
---
 crates/tincd/src/daemon/tx_control.rs |   5 +
 crates/tincd/src/udp_path.rs          |  42 +++++++++
 crates/tincd/tests/netns/udp_path.rs  | 131 ++++++++++++++++++++++++++
 3 files changed, 178 insertions(+)

diff --git a/crates/tincd/src/daemon/tx_control.rs b/crates/tincd/src/daemon/tx_control.rs
index d6aef0b8..ef995cfc 100644
--- a/crates/tincd/src/daemon/tx_control.rs
+++ b/crates/tincd/src/daemon/tx_control.rs
@@ -399,6 +399,11 @@ impl Daemon {
         }
 
         let tunnel = self.dp.tunnels.entry(target).or_default();
+        if tunnel.path.release_unanswered_seen(now, timeout) {
+            log::info!(target: "tincd::net",
+                       "UDP probes to {target_name} at {} went unanswered; trying other addresses",
+                       tunnel.path.addr().map_or_else(|| "?".to_owned(), |a| a.to_string()));
+        }
         let udp_confirmed = tunnel.path.confirmed();
 
         // Gratuitous keepalive: a type-2 reply at the largest
diff --git a/crates/tincd/src/udp_path.rs b/crates/tincd/src/udp_path.rs
index 12de7d49..bd05b0ec 100644
--- a/crates/tincd/src/udp_path.rs
+++ b/crates/tincd/src/udp_path.rs
@@ -180,6 +180,31 @@ impl UdpPath {
         }
     }
 
+    /// A seen address proves only the peer→us leg. Once our probes to it
+    /// went unanswered for `timeout` (a flushed NAT mapping, a rewritten
+    /// source), it is no better than a hint: release it so edge addresses
+    /// are explored and hints may replace it. It stays the address we probe,
+    /// now as a hint. Returns whether it was released.
+    pub(crate) fn release_unanswered_seen(&mut self, now: Instant, timeout: Duration) -> bool {
+        let Endpoint::Seen { addr, .. } = self.endpoint else {
+            return false;
+        };
+        if self.confirmed() {
+            return false;
+        }
+        let Some(p) = self.pmtu.as_mut() else {
+            return false;
+        };
+        if p.unanswered_since
+            .is_none_or(|t| now.saturating_duration_since(t) < timeout)
+        {
+            return false;
+        }
+        p.unanswered_since = None;
+        self.endpoint = Endpoint::Hint(addr);
+        true
+    }
+
     /// Gossip or relay hints can't displace a confirmed or seen address,
     /// which stops forged `REQ_KEY`s redirecting traffic.
     pub(crate) fn on_addr_hint(&mut self, addr: UnderlayAddr) -> bool {
@@ -289,6 +314,23 @@ mod tests {
         assert_eq!(p.minmtu(), 0);
     }
 
+    /// A dead seen address stops pinning once probes to it go unanswered
+    /// for a timeout window, so a hint may replace it.
+    #[test]
+    fn unanswered_seen_addr_is_released() {
+        let now = Instant::now();
+        let timeout = Duration::from_secs(30);
+        let mut p = UdpPath::default();
+        p.on_authenticated_rx(ua("192.0.2.1:655"), 0, now);
+        p.pmtu_mut(now).on_udp_probe_attempt(now, true);
+        assert!(!p.release_unanswered_seen(now + timeout / 2, timeout));
+        assert!(!p.on_addr_hint(ua("198.51.100.7:655")));
+        assert!(p.release_unanswered_seen(now + timeout, timeout));
+        assert!(!p.addr_seen());
+        assert_eq!(p.addr(), Some(addr("192.0.2.1:655")));
+        assert!(p.on_addr_hint(ua("198.51.100.7:655")));
+        assert_eq!(p.addr(), Some(addr("198.51.100.7:655")));
+    }
     #[test]
     fn rebinding_moves_the_target() {
         let now = Instant::now();
diff --git a/crates/tincd/tests/netns/udp_path.rs b/crates/tincd/tests/netns/udp_path.rs
index a677acb0..829d5ae3 100644
--- a/crates/tincd/tests/netns/udp_path.rs
+++ b/crates/tincd/tests/netns/udp_path.rs
@@ -8,6 +8,8 @@
 //! regressions should be a new scenario here, not a new file.
 
 use std::fmt;
