+#[test]
+fn an_ecdsa_key_and_what_it_signs() {
+    let (write, keys) = (ECDSA_WRITE.as_bytes(), ECDSA_KEYS.as_bytes());
+    assert!(
+        Event::read(write).is_some(),
+        "a write signed with an ECDSA key"
+    );
+    assert!(
+        Event::read(keys).is_some(),
+        "a key set signed with an ECDSA key"
+    );
+    assert_eq!(Id::of(write).to_string(), ECDSA_WRITE_ID);
+    assert_eq!(Id::of(keys).to_string(), ECDSA_KEYS_ID);
+    let mut spec = Spec::first(&[&tv(), &Party::new("lass", 2)], &[]);
+    spec.parties[0].keys = vec![ECDSA_KEY.to_owned()];
+    assert_eq!(
+        String::from_utf8(spec.json().bytes()).expect("UTF-8"),
+        ECDSA_VERSION
+    );
+    let root = spec.root();
+    assert_eq!(Id::of(&root).to_string(), ECDSA_ROOT_ID);
+    let mut store = Store::<Federation>::new(root, Vec::new()).expect("a root");
+    for event in [write, keys] {
+        assert_eq!(
+            store.offer(event.to_vec()),
+            Offered::Taken(vec![Id::of(event)])
+        );
+    }
+}
