+const ED25519: &str = "ssh-ed25519";
+const P256: &str = "ecdsa-sha2-nistp256";
+const CURVE: &[u8] = b"nistp256";
+
+/// A party's key.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Key {
+    Ed25519(PublicKey),
+    /// ECDSA on NIST P-256: its point, SEC1-encoded, uncompressed.
+    P256([u8; 65]),
+}
+
+impl Key {
+    /// From an `authorized_keys` line: its type, its base64, and maybe a comment.
+    pub(crate) fn parse(line: &str) -> Result<Key, String> {
+        let mut parts = line.split_whitespace();
+        let (Some(kind), Some(encoded)) = (parts.next(), parts.next()) else {
+            return Err(format!("not `{ED25519}|{P256} <base64> [comment]`"));
+        };
+        match kind {
+            ED25519 => return PublicKey::parse(line).map(Key::Ed25519),
+            P256 => {}
+            _ => {
+                return Err(format!(
+                    "a {kind} key: only {ED25519} and {P256} keys are taken"
+                ));
+            }
+        }
+        let blob = BASE64
+            .decode(encoded)
+            .map_err(|error| format!("its base64 doesn't decode: {error}"))?;
+        let mut reader = Reader(&blob);
+        if reader.string()? != P256.as_bytes() || reader.string()? != CURVE {
+            return Err(format!("not an {P256} key"));
+        }
+        let point: [u8; 65] = reader
+            .string()?
+            .try_into()
+            .map_err(|_| "a point that isn't 65 bytes".to_owned())?;
+        reader.end()?;
+        p256::ecdsa::VerifyingKey::from_sec1_bytes(&point)
+            .map_err(|_| "not a point on NIST P-256".to_owned())?;
+        Ok(Key::P256(point))
+    }
+
+    fn kind(&self) -> &'static str {
+        match self {
+            Key::Ed25519(_) => ED25519,
+            Key::P256(_) => P256,
+        }
+    }
