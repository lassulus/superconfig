+    /// Its SSH encoding.
+    pub(crate) fn blob(&self) -> Vec<u8> {
+        match self {
+            Key::Ed25519(key) => key.blob(),
+            Key::P256(point) => {
+                let mut blob = Vec::new();
+                string(&mut blob, P256.as_bytes());
+                string(&mut blob, CURVE);
+                string(&mut blob, point);
+                blob
+            }
+        }
+    }
+
+    /// As an `authorized_keys` line has it, without a comment.
+    pub(crate) fn line(&self) -> String {
+        format!("{} {}", self.kind(), BASE64.encode(self.blob()))
+    }
