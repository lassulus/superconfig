+// muxIP tells whether the muxes' candidates use this local address
+// (webrtc.udpmux_ips, all if empty).
+func (manager *WebRTCManagerCtx) muxIP(ip net.IP) bool {
+	return len(manager.config.UDPMuxIPs) == 0 || slices.ContainsFunc(manager.config.UDPMuxIPs, func(s string) bool {
+		return ip.Equal(net.ParseIP(s))
+	})
+}
